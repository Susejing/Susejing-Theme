{
  "id": "theme-susejlegend",
  "name": "Susejlegend",
  "version": "1.0.1",
  "apiVersion": 26,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Tema azul nocturno de Susejlegend: ciudad china, faroles y energía cian sobre el fondo oficial. / Susejlegend night-blue theme: Chinese city, lanterns and cyan energy as the official background.",
  "author": "Susejing",
  "homepage": "https://github.com/Susejing",
  "hosts": [],
  "categories": ["themes"],
  "appThemes": [
    {
      "id": "susejlegend",
      "name": {
        "es": "Susejlegend",
        "en": "Susejlegend"
      },
      "colors": {
        "accent": "#22D3EE",
        "onAccent": "#041018",
        "background": "#050B18",
        "surface": "#0C1528",
        "surfaceHigh": "#142238",
        "railPanel": "#08101C",
        "textPrimary": "#E8F4FF",
        "textSecondary": "#8FB4D4",
        "focus": "#67E8F9",
        "onFocus": "#041018",
        "outline": "#1E3A5F",
        "border": "#1E4A6E"
      },
      "background": {
        "image": {
          "asset": "background",
          "fit": "cover",
          "dim": 0.42
        }
      },
      "shape": {
        "cardRadius": 14,
        "channelRadius": 14,
        "buttonRadius": 16,
        "chipRadius": 18,
        "dialogRadius": 18,
        "inputRadius": 12,
        "heroRadius": 20,
        "railItemRadius": 14,
        "cardBorder": 1,
        "panelBorder": 1
      },
      "typography": {
        "scale": 1.0,
        "titleScale": 1.05,
        "bodyScale": 1.0
      },
      "style": {
        "gloss": 0.35
      },
      "layout": {
        "hero": "framed",
        "rail": "floating"
      },
      "surfaces": {
        "button": {
          "fill": {
            "type": "gradient",
            "colors": ["#22D3EE", "#0284C7"],
            "angle": 180
          },
          "stroke": {
            "width": 1,
            "color": "#67E8F9"
          }
        },
        "buttonGhost": {
          "fill": {
            "type": "solid",
            "color": "#0C1528"
          },
          "stroke": {
            "width": 1,
            "color": "#1E4A6E"
          }
        },
        "iconButton": {
          "fill": {
            "type": "solid",
            "color": "#0C1528"
          },
          "stroke": {
            "width": 1,
            "color": "#1E4A6E"
          }
        },
        "navActive": {
          "fill": {
            "type": "solid",
            "color": "#0A1E32"
          },
          "stroke": {
            "width": 1.5,
            "gradient": {
              "type": "gradient",
              "colors": ["#67E8F9", "#22D3EE"],
              "angle": 135
            }
          },
          "glow": {
            "color": "#22D3EE",
            "radius": 10,
            "alpha": 0.5
          }
        },
        "rail": {
          "fill": {
            "type": "solid",
            "color": "#08101C"
          },
          "stroke": {
            "width": 1,
            "color": "#1E3A5F"
          }
        },
        "card": {
          "glow": {
            "color": "#22D3EE",
            "radius": 8,
            "alpha": 0.18
          }
        },
        "cardFocus": {
          "stroke": {
            "width": 2,
            "color": "#E8F4FF"
          },
          "glow": {
            "color": "#22D3EE",
            "radius": 12,
            "alpha": 0.4
          }
        },
        "focus": {
          "stroke": {
            "width": 2,
            "color": "#E8F4FF"
          },
          "glow": {
            "color": "#22D3EE",
            "radius": 10,
            "alpha": 0.45
          }
        },
        "hero": {
          "stroke": {
            "width": 1,
            "color": "#1E4A6E"
          }
        },
        "progress": {
          "fill": {
            "type": "gradient",
            "colors": ["#67E8F9", "#0284C7"],
            "angle": 0
          }
        }
      },
      "assets": [
        {
          "id": "background",
          "path": "background.webp",
          "sha256": "39ce8d0fad0462b3033313bb79d3b9dd75aa88d13ac154a5c7f246f8b170a26d",
          "bytes": 90866
        }
      ],
      "adjustable": {
        "colors.accent": {
          "swatches": ["#22D3EE", "#38BDF8", "#818CF8", "#FBBF24"]
        },
        "background": true,
        "shape.cardRadius": { "min": 0, "max": 24 },
        "typography.scale": { "min": 0.9, "max": 1.2 }
      },
      "pluginColors": "respect"
    }
  ]
}
